{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Ti\u00eau \u0111\u1ec1"
    },
    "slug": {
      "type": "string",
      "title": "\u0110\u01b0\u1eddng d\u1eabn"
    },
    "thumbnail": {
      "type": "string",
      "title": "\u1ea2nh \u0111\u1ea1i di\u1ec7n"
    },
    "thumbnail_alt": {
      "type": "string",
      "title": "M\u00f4 t\u1ea3 \u1ea3nh \u0111\u1ea1i di\u1ec7n (alt)"
    },
    "summary": {
      "type": "string",
      "title": "T\u00f3m t\u1eaft"
    },
    "content": {
      "type": "string",
      "title": "N\u1ed9i dung d\u1ea1ng ch\u1eef (gi\u1eef t\u01b0\u01a1ng th\u00edch)"
    },
    "content_html": {
      "type": "string",
      "title": "N\u1ed9i dung so\u1ea1n th\u1ea3o (HTML)"
    },
    "gallery_images": {
      "type": "array",
      "title": "\u1ea2nh trong b\u00e0i",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "title": "Chuy\u00ean m\u1ee5c"
    },
    "tags": {
      "type": "array",
      "title": "Th\u1ebb (tags)",
      "items": {
        "type": "string"
      }
    },
    "destination": {
      "type": "string",
      "title": "\u0110i\u1ec3m \u0111\u1ebfn"
    },
    "destination_id": {
      "type": "string",
      "title": "M\u00e3 \u0111i\u1ec3m \u0111\u1ebfn"
    },
    "author": {
      "type": "string",
      "title": "T\u00e1c gi\u1ea3"
    },
    "published_at": {
      "type": "string",
      "title": "Ng\u00e0y \u0111\u0103ng"
    },
    "scheduled_at": {
      "type": "string",
      "title": "L\u00ean l\u1ecbch \u0111\u0103ng (YYYY-MM-DDTHH:mm)"
    },
    "featured": {
      "type": "boolean",
      "title": "B\u00e0i n\u1ed5i b\u1eadt",
      "default": false
    },
    "comments_enabled": {
      "type": "boolean",
      "title": "B\u1eadt b\u00ecnh lu\u1eadn",
      "default": true
    },
    "status": {
      "type": "string",
      "title": "Tr\u1ea1ng th\u00e1i",
      "enum": [
        "Nh\u00e1p",
        "Ch\u1edd duy\u1ec7t",
        "\u0110\u00e3 l\u00ean l\u1ecbch",
        "\u0110\u00e3 \u0111\u0103ng",
        "L\u01b0u tr\u1eef"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "blue",
        "green",
        "gray"
      ],
      "default": "Nh\u00e1p"
    },
    "archived": {
      "type": "boolean",
      "title": "\u0110\u00e3 l\u01b0u tr\u1eef",
      "default": false
    },
    "meta_title": {
      "type": "string",
      "title": "Meta title"
    },
    "meta_description": {
      "type": "string",
      "title": "Meta description"
    },
    "og_image": {
      "type": "string",
      "title": "\u1ea2nh chia s\u1ebb m\u1ea1ng x\u00e3 h\u1ed9i (OG image)"
    },
    "canonical_url": {
      "type": "string",
      "title": "Canonical URL"
    },
    "noindex": {
      "type": "boolean",
      "title": "Kh\u00f4ng cho m\u00e1y t\u00ecm ki\u1ebfm l\u1eadp ch\u1ec9 m\u1ee5c (noindex)",
      "default": false
    },
    "word_count": {
      "type": "number",
      "title": "S\u1ed1 t\u1eeb"
    },
    "read_minutes": {
      "type": "number",
      "title": "Th\u1eddi gian \u0111\u1ecdc (ph\u00fat)"
    },
    "view_count": {
      "type": "number",
      "title": "L\u01b0\u1ee3t xem",
      "default": 0
    },
    "cta_click_count": {
      "type": "number",
      "title": "L\u01b0\u1ee3t b\u1ea5m CTA / tour",
      "default": 0
    },
    "order_count": {
      "type": "number",
      "title": "S\u1ed1 \u0111\u01a1n ph\u00e1t sinh",
      "default": 0
    },
    "related_tour_ids": {
      "type": "array",
      "title": "Tour li\u00ean quan",
      "items": {
        "type": "string"
      }
    },
    "related_service_ids": {
      "type": "array",
      "title": "D\u1ecbch v\u1ee5 li\u00ean quan",
      "items": {
        "type": "string"
      }
    },
    "versions": {
      "type": "array",
      "title": "L\u1ecbch s\u1eed phi\u00ean b\u1ea3n",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "title": "Th\u1eddi \u0111i\u1ec3m"
          },
          "author": {
            "type": "string",
            "title": "Ng\u01b0\u1eddi l\u01b0u"
          },
          "title": {
            "type": "string",
            "title": "Ti\u00eau \u0111\u1ec1"
          },
          "summary": {
            "type": "string",
            "title": "T\u00f3m t\u1eaft"
          },
          "content_html": {
            "type": "string",
            "title": "N\u1ed9i dung"
          },
          "meta_title": {
            "type": "string",
            "title": "Meta title"
          },
          "meta_description": {
            "type": "string",
            "title": "Meta description"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}