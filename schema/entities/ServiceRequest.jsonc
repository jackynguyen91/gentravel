{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "request_code": {
      "type": "string",
      "title": "M\u00e3 y\u00eau c\u1ea7u"
    },
    "service_id": {
      "type": "string",
      "title": "M\u00e3 d\u1ecbch v\u1ee5"
    },
    "service_title": {
      "type": "string",
      "title": "T\u00ean d\u1ecbch v\u1ee5"
    },
    "service_type": {
      "type": "string",
      "title": "Lo\u1ea1i d\u1ecbch v\u1ee5"
    },
    "customer_id": {
      "type": "string",
      "title": "M\u00e3 kh\u00e1ch h\u00e0ng"
    },
    "customer_name": {
      "type": "string",
      "title": "Kh\u00e1ch h\u00e0ng"
    },
    "customer_phone": {
      "type": "string",
      "title": "\u0110i\u1ec7n tho\u1ea1i"
    },
    "customer_email": {
      "type": "string",
      "title": "Email"
    },
    "use_date": {
      "type": "string",
      "title": "Ng\u00e0y d\u00f9ng / bay / nh\u1eadn ph\u00f2ng (YYYY-MM-DD)"
    },
    "end_date": {
      "type": "string",
      "title": "Ng\u00e0y k\u1ebft th\u00fac (YYYY-MM-DD)"
    },
    "adults_count": {
      "type": "number",
      "title": "S\u1ed1 ng\u01b0\u1eddi l\u1edbn",
      "default": 1
    },
    "children_count": {
      "type": "number",
      "title": "S\u1ed1 tr\u1ebb em",
      "default": 0
    },
    "content": {
      "type": "string",
      "title": "N\u1ed9i dung y\u00eau c\u1ea7u"
    },
    "channel": {
      "type": "string",
      "title": "Ngu\u1ed3n",
      "enum": [
        "Website",
        "Facebook",
        "Zalo",
        "Hotline",
        "\u0110\u1ea1i l\u00fd",
        "Walk-in",
        "Tr\u1ef1c ti\u1ebfp",
        "B\u00e0i vi\u1ebft"
      ],
      "enumColors": [
        "blue",
        "blue",
        "green",
        "yellow",
        "purple",
        "gray",
        "gray",
        "pink"
      ],
      "default": "Hotline"
    },
    "source_post": {
      "type": "string",
      "title": "B\u00e0i vi\u1ebft ngu\u1ed3n (\u0111\u01b0\u1eddng d\u1eabn)"
    },
    "source_post_title": {
      "type": "string",
      "title": "B\u00e0i vi\u1ebft ngu\u1ed3n"
    },
    "sale_owner": {
      "type": "string",
      "title": "Nh\u00e2n vi\u00ean ph\u1ee5 tr\u00e1ch"
    },
    "quoted_price": {
      "type": "number",
      "title": "Gi\u00e1 b\u00e1o (VND)"
    },
    "cost_price": {
      "type": "number",
      "title": "Gi\u00e1 nh\u1eadp (VND)"
    },
    "status": {
      "type": "string",
      "title": "Tr\u1ea1ng th\u00e1i",
      "enum": [
        "M\u1edbi",
        "\u0110\u00e3 li\u00ean h\u1ec7",
        "\u0110\u00e3 b\u00e1o gi\u00e1",
        "\u0110\u00e3 x\u00e1c nh\u1eadn",
        "\u0110\u00e3 thanh to\u00e1n",
        "Ho\u00e0n t\u1ea5t",
        "H\u1ee7y"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "purple",
        "blue",
        "green",
        "green",
        "red"
      ],
      "default": "M\u1edbi"
    },
    "cancel_reason": {
      "type": "string",
      "title": "L\u00fd do h\u1ee7y"
    },
    "activities": {
      "type": "array",
      "title": "L\u1ecbch s\u1eed x\u1eed l\u00fd",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "title": "Th\u1eddi \u0111i\u1ec3m"
          },
          "actor": {
            "type": "string",
            "title": "Ng\u01b0\u1eddi th\u1ef1c hi\u1ec7n"
          },
          "type": {
            "type": "string",
            "title": "Lo\u1ea1i"
          },
          "text": {
            "type": "string",
            "title": "N\u1ed9i dung"
          },
          "from": {
            "type": "string",
            "title": "T\u1eeb tr\u1ea1ng th\u00e1i"
          },
          "to": {
            "type": "string",
            "title": "Sang tr\u1ea1ng th\u00e1i"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "title": "Ghi ch\u00fa",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "title": "Th\u1eddi \u0111i\u1ec3m"
          },
          "author": {
            "type": "string",
            "title": "Ng\u01b0\u1eddi ghi"
          },
          "text": {
            "type": "string",
            "title": "N\u1ed9i dung"
          }
        }
      }
    }
  },
  "required": [
    "request_code",
    "service_title",
    "customer_name",
    "customer_phone",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}